{
  "manifest_version": 3,
  "name": "Brusk Download Manager — بروسك",
  "short_name": "Brusk",
  "version": "1.3.1",
  "description": "Send downloads and videos from your browser to the Brusk download manager. يرسل التحميلات والفيديوهات إلى برنامج بروسك.",
  "browser_specific_settings": {
    "gecko": {
      "id": "barq@abdulmedia.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Brusk"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://dlwjan11-dot.github.io/brusk/"
}